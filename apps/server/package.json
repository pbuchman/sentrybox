{
  "name": "@sentrybox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "@sentrybox/domain": "workspace:*",
    "@sentrybox/protocol": "workspace:*",
    "better-sqlite3": "13.0.1",
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sentry/mcp-server": "0.37.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2"
  },
  "scripts": {
    "typecheck": "pnpm --dir ../.. exec tsc --build apps/server/tsconfig.json",
    "lint": "pnpm --dir ../.. exec eslint apps/server",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.workspace.ts --project @sentrybox/server",
    "test:integration": "pnpm --dir ../.. exec vitest run --passWithNoTests --dir apps/server/test/integration",
    "build": "pnpm --dir ../.. exec tsc --build apps/server/tsconfig.json && pnpm run copy:runtime-assets",
    "copy:runtime-assets": "pnpm run copy:storage-assets && pnpm run copy:private-ui",
    "copy:storage-assets": "mkdir -p dist/src/storage/migrations && cp src/storage/migrations/*.sql dist/src/storage/migrations/",
    "copy:private-ui": "test -f ../web/dist/index.html && rm -rf dist/private-ui && cp -R ../web/dist dist/private-ui",
    "start": "node dist/src/main.js"
  }
}
