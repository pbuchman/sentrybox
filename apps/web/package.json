{
  "name": "@sentrybox/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "vite": "8.1.5"
  },
  "scripts": {
    "typecheck": "pnpm --dir ../.. exec tsc --build apps/web/tsconfig.json",
    "lint": "pnpm --dir ../.. exec eslint apps/web",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.workspace.ts --project @sentrybox/web",
    "test:integration": "pnpm --dir ../.. exec vitest run --passWithNoTests --dir apps/web/test/integration",
    "build": "pnpm --dir ../.. exec tsc --build apps/web/tsconfig.json && pnpm exec vite build",
    "dev": "pnpm exec vite",
    "e2e": "pnpm exec playwright test --project=chromium"
  }
}
