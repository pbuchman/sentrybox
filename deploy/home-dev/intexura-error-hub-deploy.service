[Unit]
Description=Deploy a verified Intexura Error Hub release
Requires=docker.service
After=docker.service network-online.target caddy.service
Wants=network-online.target
ConditionPathExists=/var/lib/intexura-error-hub-deploy/deploy-request.json

[Service]
Type=oneshot
WorkingDirectory=/home/pbuchman/deploy/intexura-error-hub
ExecStart=/home/pbuchman/deploy/intexura-error-hub/deploy/home-dev/deploy.sh
ExecStopPost=/usr/bin/install -m 0644 /home/pbuchman/deploy/intexura-error-hub/deploy/home-dev/caddy-error-hub.caddy /etc/caddy/Caddyfile.d/intexura-error-hub.caddy
ExecStopPost=/usr/bin/caddy validate --config /etc/caddy/Caddyfile
ExecStopPost=/usr/bin/systemctl reload caddy
TimeoutStartSec=20min
UMask=0077
StateDirectory=intexura-error-hub-deploy
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pbuchman/deploy/intexura-error-hub
ReadWritePaths=/home/pbuchman/services/intexura-error-hub/data
ReadWritePaths=/home/pbuchman/services/intexura-error-hub-backups
ReadWritePaths=/var/lib/intexura-error-hub-deploy
ReadWritePaths=/run/lock
ReadWritePaths=/etc/caddy/Caddyfile.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
