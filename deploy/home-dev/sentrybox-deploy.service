[Unit]
Description=Deploy a verified SentryBox release
Requires=docker.service
After=docker.service network-online.target caddy.service
Wants=network-online.target
ConditionPathExists=/var/lib/sentrybox-deploy/deploy-request.json

[Service]
Type=oneshot
WorkingDirectory=/opt/sentrybox-control/current/deploy/home-dev
Environment=XDG_CONFIG_HOME=/var/lib/sentrybox-deploy/caddy-validation/config
Environment=XDG_DATA_HOME=/var/lib/sentrybox-deploy/caddy-validation/data
ExecStart=/opt/sentrybox-control/current/deploy/home-dev/deploy.sh
ExecStopPost=/usr/bin/install -m 0644 /opt/sentrybox-control/current/deploy/home-dev/caddy-sentrybox.caddy /etc/caddy/Caddyfile.d/sentrybox.caddy
ExecStopPost=/usr/bin/caddy validate --config /etc/caddy/Caddyfile
ExecStopPost=/usr/bin/systemctl reload caddy
TimeoutStartSec=20min
UMask=0077
StateDirectory=sentrybox-deploy
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# Caddy opens configured file loggers during validation. The running proxy uses its own mount namespace.
TemporaryFileSystem=/var/log/caddy:rw,nosuid,nodev,noexec,mode=0700,size=1M
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentrybox/data
ReadWritePaths=/var/lib/sentrybox/backups
ReadWritePaths=/var/lib/sentrybox-deploy
ReadWritePaths=/etc/caddy/Caddyfile.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
