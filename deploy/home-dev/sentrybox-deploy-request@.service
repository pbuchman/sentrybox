[Unit]
Description=Process one restricted SentryBox deployment request

[Service]
ExecStart=/usr/bin/python3 -I /opt/sentrybox-control/current/deploy/home-dev/deploy-request.py
WorkingDirectory=/opt/sentrybox-control/current/deploy/home-dev
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=21min
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sentrybox-deploy
InaccessiblePaths=/var/run/docker.sock
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
