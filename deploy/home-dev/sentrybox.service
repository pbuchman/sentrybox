[Unit]
Description=SentryBox container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/sentrybox-deploy/current.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sentrybox-control/current/deploy/home-dev
UMask=0077
ExecStart=/opt/sentrybox-control/current/deploy/home-dev/runtime.sh start
ExecReload=/opt/sentrybox-control/current/deploy/home-dev/runtime.sh reload
ExecStop=/opt/sentrybox-control/current/deploy/home-dev/runtime.sh stop
TimeoutStartSec=10min
TimeoutStopSec=2min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentrybox/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
