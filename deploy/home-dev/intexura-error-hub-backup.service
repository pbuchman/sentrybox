[Unit]
Description=Create the scheduled Intexura Error Hub backup
Requires=docker.service
After=docker.service intexura-error-hub.service

[Service]
Type=oneshot
WorkingDirectory=/home/pbuchman/deploy/intexura-error-hub
ExecStart=/home/pbuchman/deploy/intexura-error-hub/deploy/home-dev/backup.sh scheduled
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pbuchman/services/intexura-error-hub-backups
ReadWritePaths=/var/lib/intexura-error-hub-deploy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
