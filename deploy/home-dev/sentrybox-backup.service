[Unit]
Description=Create the scheduled SentryBox backup
Requires=docker.service
After=docker.service sentrybox.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sentrybox-control/current/deploy/home-dev
ExecStart=/opt/sentrybox-control/current/deploy/home-dev/backup.sh scheduled
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sentrybox/backups
ReadWritePaths=/var/lib/sentrybox-deploy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
