# Copy to /home/pbuchman/services/intexura-error-hub/env with mode 0600.
# The file owner UID/GID must match ERROR_HUB_RUNTIME_UID/GID used by Compose.
#
# Add only credentials named by ERROR_HUB_REQUIRED_SECRET_REFERENCES. The
# initial disabled-webhook configuration has no required entries, so this
# comment-only file is valid. Never store DSN public keys here.
#
# Example names (values intentionally omitted):
# CODE_AGENT_HMAC_BACKEND_DEV=
# CODE_AGENT_HMAC_BACKEND_PROD=
# LEGACY_SENTRY_DSN_BACKEND_DEV=
# LEGACY_SENTRY_DSN_BACKEND_PROD=
