[Unit]
Description=Verify an SentryBox backup by restoring it
After=docker.service
ConditionFileIsExecutable=/home/pbuchman/deploy/sentrybox/deploy/home-dev/restore-test.sh

[Service]
Type=oneshot
WorkingDirectory=/home/pbuchman/deploy/sentrybox
ExecStart=/home/pbuchman/deploy/sentrybox/deploy/home-dev/restore-test.sh
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pbuchman/services/sentrybox/backups
ReadWritePaths=/var/lib/sentrybox-deploy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
