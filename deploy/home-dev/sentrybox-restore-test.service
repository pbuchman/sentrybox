[Unit]
Description=Verify a SentryBox backup by restoring it
Requires=docker.service
After=docker.service
ConditionFileIsExecutable=/opt/sentrybox-control/current/deploy/home-dev/restore-test.sh

[Service]
Type=oneshot
WorkingDirectory=/opt/sentrybox-control/current/deploy/home-dev
ExecStart=/opt/sentrybox-control/current/deploy/home-dev/restore-test.sh
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/sentrybox/backups
ReadWritePaths=/var/lib/sentrybox-deploy
InaccessiblePaths=/var/lib/sentrybox/data
InaccessiblePaths=/var/lib/sentrybox/env
InaccessiblePaths=/etc/sentrybox
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
