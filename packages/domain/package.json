{
  "name": "@sentrybox/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "@sentrybox/protocol": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  },
  "scripts": {
    "typecheck": "pnpm --dir ../.. exec tsc --build packages/domain/tsconfig.json",
    "lint": "pnpm --dir ../.. exec eslint packages/domain",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.workspace.ts --project @sentrybox/domain",
    "test:integration": "pnpm --dir ../.. exec vitest run --passWithNoTests --dir packages/domain/test/integration",
    "build": "pnpm --dir ../.. exec tsc --build packages/domain/tsconfig.json"
  }
}
