{
  "name": "intexura-error-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "build": "pnpm --filter @intexura-error-hub/domain build && pnpm --filter @intexura-error-hub/protocol build && pnpm --filter @intexura-error-hub/web build && pnpm --filter @intexura-error-hub/server build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0",
    "vitest": "4.1.10"
  }
}
